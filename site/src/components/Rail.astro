---
import pkg from '../../../package.json';
import { FRAME, INSET, still } from '../live/logo';
import { extra, foot, sections, start, under } from '../nav';
import Search from './Search.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const here = Astro.url.pathname;
const link = (slug: string) => `${base}${slug ? `${slug}/` : ''}`;
const current = (slug: string) => (here === link(slug) ? 'page' : undefined);
const aspect = `${FRAME.across} / ${FRAME.down}`;
const inset = INSET.left;
const word = 1 - INSET.left - INSET.right;
---
<nav class="rail" aria-label="Pages">
  <a class="mark" href={link('')} aria-label="blinken">
    <span class="still"><Fragment set:html={still()} /></span>
    <canvas aria-hidden="true"></canvas>
  </a>
  <p class="meta">
    <a href={link('changelog')}>v{pkg.version}</a>
  </p>
  <Search />
  <ul class="group">
    {start.map((p) => (
      <li>
        <a href={link(p.slug)} aria-current={current(p.slug)}>{p.title}</a>
        {under[p.slug] && here.startsWith(link(p.slug)) && (
          <ul class="sub">
            {under[p.slug].map((g) => (
              <li><a href={link(`${p.slug}/${g.slug}`)} aria-current={current(`${p.slug}/${g.slug}`)}>{g.title}</a></li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  {sections.map((s) => (
    <div class="group">
      {s.pages.length > 1 && <h2 class="section">{s.title}</h2>}
      <ol>
        {s.pages.map((w) => (
          <li><a href={link(w.slug)} aria-current={current(w.slug)}>{w.title}</a></li>
        ))}
      </ol>
    </div>
  ))}
  <ul class="group">
    {extra.map((w) => (
      <li><a href={w.href ? `${base}${w.href}` : link(w.slug)} aria-current={current(w.slug)}>{w.title}</a></li>
    ))}
  </ul>
  <p class="meta out">
    {foot.map((p) => <a href={link(p.slug)} aria-current={current(p.slug)}>{p.title}</a>)}
    <a href="https://github.com/orochi235/blinken">GitHub</a>
    <a href={`https://www.npmjs.com/package/${pkg.name}`}>npm</a>
  </p>
</nav>

<script>
  import { playLogo } from '../live/logo';

  const mark = document.querySelector<HTMLElement>('.rail .mark');
  const canvas = mark?.querySelector('canvas');
  if (mark && canvas) {
    try {
      playLogo(canvas);
      mark.classList.add('lit');
    } catch (e) {
      mark.classList.add('failed');
      throw e;
    }
  }
</script>

<style define:vars={{ aspect, inset, word }}>
  .rail {
    padding: 2rem 1.25rem;
    font: 500 0.95rem / 1.4 var(--label);
    font-stretch: 87.5%;
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    /* The dark-mode mark's blank margins hang past the rail. */
    overflow-x: hidden;
  }

  ol,
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    display: block;
    padding: 0.3rem 0;
    text-decoration: none;
    color: var(--ink-soft);
  }

  li a:hover,
  li a[aria-current='page'] {
    color: var(--ink);
  }

  li a[aria-current='page'] {
    box-shadow: inset 3px 0 0 var(--voice-1);
    padding-left: 0.6rem;
  }

  .sub {
    margin: 0 0 0.3rem 0.75rem;
    font-size: 0.88rem;
  }

  .group + .group {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  /* The logo is a sign of its own, shaped by `--aspect`, with the still standing in until it lights. */
  /* Sized so the word's ink spans the rail's text column exactly, its border hanging past both sides. */
  .mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: calc(100% / var(--word));
    aspect-ratio: var(--aspect);
    margin: 0 0 0.9rem calc(-100% * var(--inset) / var(--word));
  }

  .still,
  .mark canvas {
    grid-area: 1 / 1;
  }

  .still {
    width: 100%;
    height: 100%;
  }

  .still :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .mark.lit .still {
    visibility: hidden;
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    margin: 0 0 1rem;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  /* Out of the site, at the rail's foot. */
  .meta.out {
    margin: auto 0 0;
    padding-top: 1.5rem;
  }

  .section {
    margin: 0 0 0.3rem;
    font: 700 0.72rem var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .meta a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .meta a:hover {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .rail {
      position: static;
      height: auto;
      display: block;
      border-bottom: 1px solid var(--rule);
      padding: 1rem;
    }
    .group > ol,
    ul.group {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1rem;
    }
    .group + .group {
      margin-top: 0.5rem;
      padding-top: 0.5rem;
    }
    .sub {
      display: none;
    }
    .mark {
      width: calc(12rem / var(--word));
      margin-left: calc(-12rem * var(--inset) / var(--word));
    }
  }
</style>
