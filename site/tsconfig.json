{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@msb235/blinken/mechanical": ["../src/mechanical/index.ts"],
      "@msb235/blinken": ["../src/index.ts"],
      "@msb235/blits/gpu": [
        "../../blits/src/gpu.ts",
        "../node_modules/@msb235/blits/dist/gpu.d.ts"
      ],
      "@msb235/blits": ["../../blits/src/index.ts", "../node_modules/@msb235/blits"],
      "@msb235/blits-panel": [
        "../../blits/packages/panel/src/index.ts",
        "../node_modules/@msb235/blits-panel/dist/index.d.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [".astro/types.d.ts", "src"]
}
