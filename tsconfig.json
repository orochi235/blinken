{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@msb235/blits/gpu": ["../blits/src/gpu.ts", "./node_modules/@msb235/blits/dist/gpu.d.ts"],
      "@msb235/blits": ["../blits/src/index.ts", "./node_modules/@msb235/blits"],
      "@msb235/blits-panel": [
        "../blits/packages/panel/src/index.ts",
        "./node_modules/@msb235/blits-panel/dist/index.d.ts"
      ]
    }
  },
  "include": ["src", "test", "lab", "player", "*.ts"]
}
