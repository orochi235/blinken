{
  "name": "@msb235/blinken",
  "version": "0.1.0",
  "description": "An old-fashioned LED marquee on a canvas, and the composable blits effects it plays",
  "license": "MIT",
  "author": "orochi235",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/blinken.git"
  },
  "homepage": "https://github.com/orochi235/blinken#readme",
  "bugs": "https://github.com/orochi235/blinken/issues",
  "keywords": [
    "led",
    "marquee",
    "sign",
    "canvas",
    "webgpu",
    "webgl",
    "animation",
    "blits"
  ],
  "type": "module",
  "sideEffects": [
    "./dist-player/blinken-player.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player": "./dist-player/blinken-player.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist-player/blinken-player.js",
  "jsdelivr": "./dist-player/blinken-player.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/glyphs/fonts/spleen.LICENSE",
    "src/glyphs/fonts/OFL.txt",
    "src/glyphs/fonts/CREDITS.md",
    "dist-player/blinken-player.js",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build && BLITS=npm node scripts/compile.mjs",
    "dev": "vite lab",
    "lab:build": "vite build lab",
    "compile": "node scripts/compile.mjs",
    "player:check": "node scripts/compile.mjs && node scripts/player-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "smoke": "npm run lab:build && node scripts/smoke.mjs",
    "shots": "npm run lab:build && node scripts/shots.mjs",
    "test:gpu": "node test/gpu/run.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:readouts": "node scripts/bench.mjs --page digits --ways shared,readouts --digits 100,500,1000 --stack ''"
  },
  "dependencies": {
    "@msb235/blits": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@msb235/blits-panel": "0.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@weasel-js/animator": "1.16.1",
    "@weasel-js/core": "1.16.1",
    "@weasel-js/diagram": "1.16.1",
    "@weasel-js/font": "1.16.1",
    "@weasel-js/history": "1.16.1",
    "@weasel-js/labkit": "1.16.1",
    "@weasel-js/theme": "1.16.1",
    "@weasel-js/ui": "1.16.1",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.5"
  }
}
