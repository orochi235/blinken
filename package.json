{
  "name": "bree",
  "version": "0.0.0",
  "private": true,
  "description": "An old-fashioned LED marquee on a canvas, and the composable blits effects it plays",
  "license": "MIT",
  "author": "orochi235",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "vite lab",
    "lab:build": "vite build lab",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "smoke": "npm run lab:build && node scripts/smoke.mjs",
    "shots": "npm run lab:build && node scripts/shots.mjs",
    "test:gpu": "node test/gpu/run.mjs",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "@msb235/blits": "^0.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@msb235/blits-panel": "0.8.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@weasel-js/animator": "1.15.0",
    "@weasel-js/core": "1.15.0",
    "@weasel-js/diagram": "1.15.0",
    "@weasel-js/font": "1.15.0",
    "@weasel-js/history": "1.15.0",
    "@weasel-js/labkit": "1.15.0",
    "@weasel-js/theme": "1.15.0",
    "@weasel-js/ui": "1.15.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.5"
  }
}
